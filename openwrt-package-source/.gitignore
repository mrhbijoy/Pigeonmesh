# Locally built apk-tools, used only to produce OpenWrt apk v3 packages.
# Rebuild with build/get-apk-tools.sh rather than committing a binary.
.tools/

# Build output and staging.
dist/
.stage/

# The feed Makefile expects a "files" symlink to ../src; it is created by the
# build rather than committed, since Windows checkouts turn it into a junction.
openwrt-feed/files
