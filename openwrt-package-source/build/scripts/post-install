#!/bin/sh
# Runs on the router after the package files are in place.
[ -n "$IPKG_INSTROOT" ] && exit 0

mkdir -p /var/lib/pigeonmesh /etc/pigeonmesh/store

# Firewall, alias address, DNS. Idempotent, so running it on every upgrade is
# both safe and how a changed default reaches an existing install.
[ -x /etc/uci-defaults/99-pigeonmesh ] && sh /etc/uci-defaults/99-pigeonmesh

/etc/init.d/pigeonmesh enable
/etc/init.d/pigeonmesh restart
[ -x /etc/init.d/pm-bridge-sync ] && /etc/init.d/pm-bridge-sync enable >/dev/null 2>&1 && /etc/init.d/pm-bridge-sync restart >/dev/null 2>&1 || true

# Clear LuCI cache and reload uhttpd so LuCI menus appear immediately
rm -rf /tmp/luci-indexcache* /tmp/luci-modulecache* 2>/dev/null || true
[ -x /etc/init.d/uhttpd ] && /etc/init.d/uhttpd restart >/dev/null 2>&1 || true

exit 0
