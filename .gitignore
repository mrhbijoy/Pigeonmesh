# Not published yet.
pigeonmesh-apk/
pigeonmesh-disaster-kit/

# Build output. Packages are produced by openwrt-package-source/build/build.sh
# and attached to releases rather than committed.
dist/

# Note: there is deliberately no bare "build/" rule here.
# openwrt-package-source/build/ holds build.sh and the maintainer scripts --
# it is source, not output, and a blanket rule silently excluded all of it.

